# OMNI-PHARM settings - copy to .env and edit. Every line is optional.

# Shared PIN for network use (ignored when user accounts exist: scripts\users.py)
# OMNIPHARM_ACCESS_PIN=1234

# Local LLM for the AI report (Ollama model name)
# OMNIPHARM_LLM_MODEL=gemma4:12b

# PubChem name lookup for drugs that are not in the local databases (sends the drug name only)
# OMNIPHARM_ONLINE_LOOKUP=true

# Commercial deployment: switch off research-licensed data (TWOSIDES pair model / signals, KEGG Japanese names)
# OMNIPHARM_COMMERCIAL_SAFE=false

# data.go.kr service key - only to re-download MFDS products / DUR (pipeline stages mfds, dur, strengths)
# OMNIPHARM_DATA_GO_KR_API_KEY=
